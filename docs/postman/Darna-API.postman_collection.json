{
  "info": {
    "_postman_id": "darna-api-v1-v2",
    "name": "Darna Real Estate API",
    "description": "Postman collection for Darna API V1 and V2. Set collection variables baseUrl, token, and propertyId before running. Protected requests use Bearer token authentication. Update request body is an editable example; adjust fields to the rules in UpdatePropertyRequest.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "propertyId",
      "value": "4",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "V1",
      "item": [
        {
          "name": "List properties (cursor pagination + filters)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "description": "Public endpoint. Optional filters and cursor pagination. Verify accepted filter names in PropertyFilterRequest.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/properties",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "properties"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "15",
                  "disabled": false
                },
                {
                  "key": "governorate_id",
                  "value": "",
                  "disabled": false
                },
                {
                  "key": "listing_type",
                  "value": "",
                  "disabled": false
                },
                {
                  "key": "min_price",
                  "value": "",
                  "disabled": false
                },
                {
                  "key": "max_price",
                  "value": "",
                  "disabled": false
                },
                {
                  "key": "cursor",
                  "value": "",
                  "disabled": false
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Featured properties",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "description": "Public endpoint: returns featured properties.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/properties/featured",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "properties",
                "featured"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Governorate statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "description": "Public endpoint: counts available properties grouped by governorate.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/properties/statistics/governorates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "properties",
                "statistics",
                "governorates"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Show property",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "description": "Public endpoint: fetch one available property.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/properties/{{propertyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "properties",
                "{{propertyId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Update property",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Protected endpoint. Requires a Sanctum bearer token and ownership authorization. Example body only; confirm allowed fields in UpdatePropertyRequest.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/properties/{{propertyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "properties",
                "{{propertyId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated test property\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Delete property",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "description": "Protected endpoint. Requires a Sanctum bearer token and ownership authorization. Use only with a disposable test property.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/properties/{{propertyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "properties",
                "{{propertyId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
